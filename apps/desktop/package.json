{
  "name": "@jkauto/desktop",
  "version": "0.2.0",
  "description": "Desktop IDE for authoring and running automated tests",
  "author": {
    "name": "Nhat",
    "email": "vnhat.dev@gmail.com"
  },
  "homepage": "https://github.com/nhatcoi/jkauto",
  "license": "MIT",
  "desktopName": "JKAuto",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox --disable-gpu",
    "build": "electron-vite build",
    "package": "pnpm build && electron-builder --publish never",
    "package:linux": "pnpm build && electron-builder --linux AppImage deb --publish never",
    "package:windows": "pnpm build && electron-builder --win nsis --publish never",
    "package:mac": "pnpm build && electron-builder --mac dmg --publish never",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "fetch-scrcpy-server": "fetch-scrcpy-server 3.1",
    "postinstall": "fetch-scrcpy-server 3.1 && electron-rebuild -f -o better-sqlite3",
    "rebuild": "electron-rebuild -f -o better-sqlite3"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.71",
    "@apidevtools/swagger-parser": "^12.1.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/mcp": "0.0.76",
    "@playwright/test": "^1.46.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-separator": "^1.1.10",
    "@uiw/react-codemirror": "^4.25.10",
    "ai": "^6.0.206",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^3.6.0",
    "nanoid": "^5.1.11",
    "openai": "^6.42.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.8.4",
    "recharts": "^3.8.1",
    "swagger-parser": "^10.0.3",
    "tree-sitter": "^0.21.0",
    "tree-sitter-go": "^0.21.0",
    "tree-sitter-java": "^0.21.0",
    "tree-sitter-javascript": "^0.21.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-rust": "^0.21.0",
    "tree-sitter-typescript": "^0.21.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@electron/rebuild": "^4.0.4",
    "@jkauto/core": "workspace:*",
    "@jkauto/engine": "workspace:*",
    "@jkauto/indexer": "workspace:*",
    "@radix-ui/react-context-menu": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.62.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@yume-chan/adb": "^2.6.0",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/fetch-scrcpy-server": "^1.0.0",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "@yume-chan/stream-extra": "^2.6.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron": "^32.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.462.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-arborist": "^3.0.0",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.6",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.4",
    "vite": "^5.4.10",
    "zustand": "^5.0.1"
  },
  "build": {
    "appId": "dev.vnhat.jkauto",
    "productName": "JKAuto",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@yume-chan/fetch-scrcpy-server/server.bin",
        "to": "scrcpy/server.bin"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "icon": "src/renderer/src/assets/logo.png",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "executableName": "jkauto"
    },
    "win": {
      "icon": "src/renderer/src/assets/logo.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "src/renderer/src/assets/logo.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
