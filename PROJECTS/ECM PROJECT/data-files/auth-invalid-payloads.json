{
  "schemaVersion": 1,
  "description": "Structured invalid payloads for boundary and negative API testing",
  "login": {
    "missingPassword": {
      "payload": { "username": "admin" },
      "expectedStatus": 400,
      "expectedContains": "password",
      "scenario": "boundary",
      "description": "Login without password field"
    },
    "missingUsername": {
      "payload": { "password": "Admin@123" },
      "expectedStatus": 400,
      "expectedContains": "username",
      "scenario": "boundary",
      "description": "Login without username field"
    },
    "emptyBody": {
      "payload": {},
      "expectedStatus": 400,
      "scenario": "boundary",
      "description": "Login with empty JSON body"
    },
    "nullFields": {
      "payload": { "username": null, "password": null },
      "expectedStatus": 400,
      "scenario": "boundary",
      "description": "Login with null field values"
    },
    "wrongCredentials": {
      "payload": { "username": "admin", "password": "wrongpassword" },
      "expectedStatus": 401,
      "expectedContains": "Invalid credentials",
      "scenario": "negative",
      "description": "Correct username, wrong password"
    },
    "wrongUsername": {
      "payload": { "username": "notexist", "password": "Admin@123" },
      "expectedStatus": 401,
      "scenario": "negative",
      "description": "Non-existent username"
    }
  },
  "register": {
    "invalidEmail": {
      "payload": { "username": "testinv", "email": "not-an-email", "password": "Password@123", "role": "editor" },
      "expectedStatus": 400,
      "expectedContains": "email",
      "scenario": "negative",
      "description": "Invalid email format"
    },
    "weakPassword": {
      "payload": { "username": "testinv", "email": "testinv@example.com", "password": "weak", "role": "editor" },
      "expectedStatus": 400,
      "expectedContains": "password",
      "scenario": "negative",
      "description": "Password too weak (too short, no uppercase/special)"
    },
    "invalidRole": {
      "payload": { "username": "testinv", "email": "testinv@example.com", "password": "Password@123", "role": "superadmin" },
      "expectedStatus": 400,
      "expectedContains": "role",
      "scenario": "negative",
      "description": "Invalid role value — only admin/editor/viewer allowed"
    },
    "reservedUsername": {
      "payload": { "username": "admin", "email": "test_conflict@example.com", "password": "Password@123", "role": "editor" },
      "expectedStatus": 409,
      "scenario": "negative",
      "description": "Username 'admin' is reserved/already seeded — expect 409 conflict"
    },
    "missingAllFields": {
      "payload": {},
      "expectedStatus": 400,
      "scenario": "boundary",
      "description": "Empty body — all required fields missing"
    }
  },
  "documents": {
    "missingTitle": {
      "payload": { "description": "No title doc", "status": "draft" },
      "expectedStatus": 400,
      "expectedContains": "title",
      "scenario": "boundary",
      "description": "Create document without required title"
    },
    "invalidStatus": {
      "payload": { "title": "Test Doc", "description": "Bad status", "status": "invalid_status" },
      "expectedStatus": 400,
      "expectedContains": "status",
      "scenario": "negative",
      "description": "Invalid document status value"
    },
    "emptyTitle": {
      "payload": { "title": "", "description": "Empty title", "status": "draft" },
      "expectedStatus": 400,
      "scenario": "boundary",
      "description": "Empty string title"
    }
  },
  "folders": {
    "missingName": {
      "payload": {},
      "expectedStatus": 400,
      "expectedContains": "name",
      "scenario": "boundary",
      "description": "Create folder without required name"
    },
    "emptyName": {
      "payload": { "name": "" },
      "expectedStatus": 400,
      "scenario": "boundary",
      "description": "Create folder with empty string name"
    }
  }
}
